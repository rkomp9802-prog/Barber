# Backend API (apps/api). Скопируйте в apps/api/.env и заполните.
# На Vercel те же переменные задаются в Project Settings → Environment Variables.
# Секреты никогда не попадают во frontend.

# ---------- База данных (Supabase → Project Settings → Database → Connect) ----------
# Приложение: пулер Supavisor в transaction mode, порт 6543.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Миграции и seed (prisma CLI): прямое/сессионное подключение, порт 5432.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# Сколько соединений держит один инстанс API (на Vercel лучше 1–5).
DB_POOL_MAX=5

# ---------- HTTP ----------
PORT=4000
HOST=0.0.0.0
# development | test | production
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Разрешённые origin через запятую: сайт (Next.js :3000) и Mini App (Vite :5174).
CORS_ORIGINS="http://localhost:3000,http://localhost:5174"
# За прокси Vercel — true (правильный IP клиента для rate limit).
TRUST_PROXY=true
# Запросов в минуту с одного IP: всего / на POST /bookings.
RATE_LIMIT_MAX=100
BOOKING_RATE_LIMIT_MAX=10

# ---------- Публичные адреса ----------
APP_URL="http://localhost:3000"
API_URL="http://localhost:4000"

# ---------- Telegram (этапы 6–7) ----------
# Токен бота от @BotFather: проверка initData Mini App. Без него /me/bookings отвечает 401.
TELEGRAM_BOT_TOKEN=""
# Имя бота без @ — для ссылки t.me/<bot>?start=b_<token> в ответе записи.
TELEGRAM_BOT_USERNAME=""
# Срок жизни initData в секундах (по умолчанию 24 часа).
TELEGRAM_INIT_DATA_MAX_AGE_SEC=86400
# Бот включается только при заданном TELEGRAM_BOT_TOKEN (уведомления, /start, webhook).
# Секрет webhook: 16–256 символов A-Z a-z 0-9 _ -. То же значение передаётся в setWebhook (npm run telegram:set-webhook).
# Без него webhook не регистрируется: открытый эндпоинт небезопасен.
TELEGRAM_WEBHOOK_SECRET=""
# https-адрес Mini App: кнопка «Записаться» в меню бота и кнопка меню чата. Пусто — кнопки нет.
MINIAPP_URL=""

# ---------- Первый администратор (только для npm run db:seed) ----------
ADMIN_LOGIN="admin"
# Минимум 8 символов. В базе хранится только Argon2-хеш.
ADMIN_PASSWORD=""

# ---------- Админка (этап 9) ----------
# SameSite cookie сессии: lax (сайт и API на одном домене, по умолчанию) | strict | none.
# none — только если сайт и API на разных сайтах; Secure включается автоматически.
ADMIN_COOKIE_SAMESITE=lax
# Домен cookie (необязательно). Пусто — cookie только для хоста API.
ADMIN_COOKIE_DOMAIN=""
# Попыток входа в минуту с одного IP (защита от перебора; задержка по логину добавляется сверху).
ADMIN_LOGIN_RATE_LIMIT_MAX=5

# ---------- Фото барберов и портфолио (Supabase Storage, необязательно) ----------
# Без этих двух переменных загрузка файлов отключена (POST /admin/uploads → 422); фото можно вставить ссылкой https.
SUPABASE_URL=""
# Секрет service role: только на сервере, никогда не во frontend.
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="public-media"
# Максимум байт на файл (не больше 5 МБ).
UPLOAD_MAX_BYTES=5242880

# ---------- Тесты ----------
# Отдельная пустая база с применёнными миграциями. Если задана — запускаются интеграционные тесты
# (таблицы в ней ОЧИЩАЮТСЯ). Никогда не указывайте здесь production-базу.
# TEST_DATABASE_URL="postgresql://..."
